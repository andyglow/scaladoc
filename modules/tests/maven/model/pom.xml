<?xml version="1.0" encoding="UTF-8"?>
<!-- publishes the scaladoc of its classes; on Scala 2 the compiler plugin embeds it, except demo.model.internal.* -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>demo</groupId>
    <artifactId>scaladoc-maven-tests</artifactId>
    <version>0</version>
  </parent>

  <artifactId>model</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>${scala.library}</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Scala 2: what getting-started.md shows for a module whose scaladoc gets embedded: the compiler plugin, and
         scaladoc-annotation, which the classes it embeds into refer to. Without it, Scala 3 modules that use them don't
         compile. On Scala 3 such a module needs nothing at all. -->
    <profile>
      <id>embed</id>
      <activation><property><name>scala</name><value>!3</value></property></activation>
      <dependencies>
        <dependency>
          <groupId>io.github.andyglow</groupId>
          <artifactId>scaladoc-annotation</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>net.alchim31.maven</groupId>
            <artifactId>scala-maven-plugin</artifactId>
            <configuration>
              <compilerPlugins>
                <compilerPlugin>
                  <groupId>io.github.andyglow</groupId>
                  <artifactId>scaladoc-compiler-plugin_${scala.binary}</artifactId>
                  <version>${scaladoc.version}</version>
                </compilerPlugin>
              </compilerPlugins>
              <args>
                <arg>-P:scaladoc-compiler-plugin:exclude:class:demo.model.internal.*</arg>
              </args>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
