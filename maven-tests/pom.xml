<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Maven setup that docs/src/getting-started.md shows, as a real build, so the docs can't drift from what works.
  `model` documents classes: on Scala 2 the compiler plugin embeds their scaladoc, except demo.model.internal.*.
  `app` reads it with Scaladoc.of, and fails the build if it isn't what was written.

  The libraries come from the local Maven repository in the version under test, so the sbt build runs it after
  `+publishM2` (its `mavenCheck` task), once per Scala version:

    ./mvnw -B -Dscala=2.13 -Dscaladoc.version=0.4.1-SNAPSHOT verify      (also -Dscala=2.12 and -Dscala=3)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>demo</groupId>
  <artifactId>scaladoc-maven-tests</artifactId>
  <version>0</version>
  <packaging>pom</packaging>

  <modules>
    <module>model</module>
    <module>app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <profiles>
    <profile>
      <id>scala-2.13</id>
      <activation><property><name>scala</name><value>2.13</value></property></activation>
      <properties>
        <scala.version>2.13.18</scala.version>
        <scala.binary>2.13</scala.binary>
        <scala.library>scala-library</scala.library>
        <excluded>excluded</excluded>
      </properties>
    </profile>
    <profile>
      <id>scala-2.12</id>
      <activation><property><name>scala</name><value>2.12</value></property></activation>
      <properties>
        <scala.version>2.12.21</scala.version>
        <scala.binary>2.12</scala.binary>
        <scala.library>scala-library</scala.library>
        <excluded>excluded</excluded>
      </properties>
    </profile>
    <profile>
      <id>scala-3</id>
      <activation><property><name>scala</name><value>3</value></property></activation>
      <properties>
        <scala.version>3.3.9</scala.version>
        <scala.binary>3</scala.binary>
        <scala.library>scala3-library_3</scala.library>
        <!-- Scala 3 has no compiler plugin, so nothing is excluded -->
        <excluded>none</excluded>
      </properties>
      <build>
        <pluginManagement>
          <plugins>
            <!-- on Scala 3, -Yread-docs lets Scaladoc.of read doc comments from TASTy: other modules and jars -->
            <plugin>
              <groupId>net.alchim31.maven</groupId>
              <artifactId>scala-maven-plugin</artifactId>
              <configuration>
                <args>
                  <arg>-Yread-docs</arg>
                </args>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.scala-lang</groupId>
        <artifactId>${scala.library}</artifactId>
        <version>${scala.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andyglow</groupId>
        <artifactId>scaladoc-ast_${scala.binary}</artifactId>
        <version>${scaladoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.andyglow</groupId>
        <artifactId>scaladoc-parser_${scala.binary}</artifactId>
        <version>${scaladoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>net.alchim31.maven</groupId>
          <artifactId>scala-maven-plugin</artifactId>
          <version>4.10.0</version>
          <configuration>
            <scalaVersion>${scala.version}</scalaVersion>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>compile</goal>
                <goal>testCompile</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
